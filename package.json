{
  "name": "bragvault",
  "version": "0.2.0",
  "description": "BragVault plugin for Cursor, Claude Code, and Codex: passively captures your engineering accomplishments from git activity and agent sessions, keeps raw history local, and optionally syncs structured accomplishments to your BragVault account.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hi5-labs/bragvault-plugin.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "cursor",
    "codex",
    "brag-document",
    "accomplishments"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "bragvault": "dist/bragvault-mcp.js",
    "bragvault-mcp": "dist/bragvault-mcp.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.0.0"
  }
}